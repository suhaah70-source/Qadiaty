# ==== Application ====
APP_NAME=Multi-Tenant Store Platform
ENV=development
DEBUG=true

# ==== Security ====
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@localhost:5432/platform_db
SYNC_DATABASE_URL=postgresql+psycopg2://platform_user:platform_pass@localhost:5432/platform_db

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== Object Storage (S3 / MinIO compatible) ====
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=platform-media
S3_REGION=us-east-1

# ==== CORS ====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==== تسجيل الدخول الاجتماعي (اختياري لكن مطلوب في الإنتاج) ====
# اتركهم فارغين وقت التطوير المحلي إن حبيت، لكن بدونهم أي id_token/
# access_token صالح شكليًا (حتى لتطبيق آخر) يُقبل — لازم تعبيهم قبل النشر.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
